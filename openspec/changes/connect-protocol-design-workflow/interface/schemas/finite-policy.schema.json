{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trialledger.invalid/schemas/protocol/1/finite-policy.schema.json",
  "version": "1",
  "title": "finite_policy operator data and claims",
  "description": "C6. Input of protocol_policies.check(kind, data, claims).",
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "resolution": {
          "$ref": "common.schema.json#/$defs/resolution"
        },
        "basis": {
          "$ref": "common.schema.json#/$defs/basis"
        }
      },
      "required": [
        "ref",
        "version",
        "status",
        "resolution",
        "basis"
      ],
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/literal"
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "values"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/proposition"
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "id",
        "condition",
        "rule"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "scope": {
          "type": "object",
          "properties": {
            "level": {
              "enum": [
                "participant",
                "cohort",
                "study"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "level",
            "ref"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "id",
        "scope",
        "description"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "guard": {
          "$ref": "common.schema.json#/$defs/proposition"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "guard",
        "actions"
      ],
      "additionalProperties": false
    },
    "prohibition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "state": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          ]
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/proposition"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "id",
        "state",
        "condition",
        "actions",
        "rule"
      ],
      "additionalProperties": false
    },
    "invariant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "state": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          ]
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/proposition"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 0
        },
        "rule": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "id",
        "state",
        "condition",
        "actions",
        "rule"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          },
          "maxItems": 32
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "initial": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "terminal": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 32,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          },
          "maxItems": 128
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prohibition"
          },
          "maxItems": 32
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invariant"
          },
          "maxItems": 32
        }
      },
      "required": [
        "scope",
        "version",
        "variables",
        "constraints",
        "states",
        "initial",
        "terminal",
        "actions",
        "transitions",
        "prohibitions",
        "invariants"
      ],
      "additionalProperties": false,
      "description": "Cross-field rules are out of schema scope: unique ids, state/action/variable references, initial/terminal subsets, terminal states without outgoing transitions, the reserved policy_state variable, the 4096-valuation product (policy_valuation_limit)."
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "enum": [
            "coverage",
            "exclusivity",
            "prohibition",
            "invariant",
            "termination"
          ]
        },
        "witness_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      },
      "required": [
        "id",
        "claim",
        "witness_limit"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "maxItems": 5,
      "description": "Each claim kind and id at most once (semantic: policy_duplicate_claim)."
    }
  }
}
