                    "cough monitoring",
                    "Leicester Cough Monitor"
                  ]
                }
              ]
            },
            "outcomesModule": {
              "primaryOutcomes": [
                {
                  "measure": "Change in cough frequency measured by cough recorder at week 12 compared to baseline",
                  "timeFrame": "12 weeks"
                }
              ],
              "secondaryOutcomes": [
                {
                  "measure": "Impact of cough on quality of life",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Change in cough frequency measured by cough recorder at 4 weeks compared to baseline",
                  "timeFrame": "4 weeks"
                }
              ],
              "otherOutcomes": [
                {
                  "measure": "Change in Leicester Cough Questionnaire at week 12 compared to baseline",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Change in Visual Analogue Score at week 12 compared to baseline",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Change in cough frequency in relation to FVC",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Clinical characteristics predictive of cough response",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Impact of cough on anxiety and depression",
                  "timeFrame": "12 weeks"
                },
                {
                  "measure": "Change in cough frequency in relation to TLCOc",
                  "timeFrame": "12 weeks"
                }
              ]
            },
            "eligibilityModule": {
              "eligibilityCriteria": "Inclusion Criteria:\n\n* Diagnosis of IPF according to American Thoracic Society (ATS) / European Respiratory Society (ERS) criteria (5), definite and probable patients will be eligible\n* Written informed consent\n* Daily cough related to IPF (exclusion of other causes) present \\> 8 weeks\n* cough score on visual analogue scale of ≥ 40 mm.\n* Carbon monoxide transfer capacity corrected for hemoglobin (TLCOc) ≥ 30% and Forced Vital Capacity (FVC) ≥ 50%\n* Pirfenidone therapy about to be initiated\n* if a history positive for Gastro Esophageal Reflux (GER), using proton pump inhibitor (PPI) \\> 4 weeks\n\nExclusion Criteria:\n\n* Opiates, antitussive medication, antihistamines, steroids \\> equivalent of 10 mg prednisone or N-acetylcysteine (NAC) within two weeks before study\n* Change of steroid \\< 10 mg, inhalation steroids within 2 weeks of the study - History of bronchial hyper responsiveness or asthma or relevant airway obstruction (FEV1/FVC \\< 0.7)\n* within 6 weeks of the start signs of respiratory tract infection, change of sputum production and fever.",
              "healthyVolunteers": false,
