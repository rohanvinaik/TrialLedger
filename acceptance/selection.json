 },
 "seed": 20261101,
 "criteria": "Twenty trials, one per stratum, so that together they span every study type (interventional, observational, expanded access); the phases EARLY_PHASE1, PHASE1, PHASE2, PHASE3, PHASE4 and NA, with two combined-phase records; the overall statuses COMPLETED, TERMINATED, RECRUITING, NOT_YET_RECRUITING, ACTIVE_NOT_RECRUITING, WITHDRAWN, SUSPENDED, UNKNOWN, ENROLLING_BY_INVITATION and the expanded-access statuses; results posted and not; the lead sponsor classes INDUSTRY, OTHER, NIH, FED, NETWORK, OTHER_GOV and INDIV; record size from the smallest of five draws to the largest of five; and at least one record whose identification lists NCT ID aliases. Strata are fixed in this script before any draw; the draws are seeded; nothing about TrialLedger's output informs them.",
 "method": {
  "whole_stratum_at_most": 3000,
  "max_windows": 12,
  "months": "2000-01 to 2026-09",
  "size_draws": 5,
  "choice": "random.Random(f'{seed}/{stratum}/choice/{attempt}').choice(sorted IDs)"
 },
